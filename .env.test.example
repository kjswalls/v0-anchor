# Copy this file to .env.test and fill in real test credentials.
# NEVER commit .env.test — it is git-ignored (.gitignore matches `.env*`).
#
# playwright.config.ts loads .env.test itself via dotenv, so `pnpm e2e` needs no
# wrapper command. Real environment variables take precedence, which is how CI —
# where these are injected as job-level env from GitHub Actions secrets — works.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# REQUIRED. Every /api/agent/* write path calls createServiceClient(), which
# throws without this (lib/supabase-service.ts). The E2E API helpers
# (createTestTask, createTestHabit) go through those routes, so omitting it
# surfaces as `createTestTask failed (500): Missing ... SUPABASE_SECRET_KEY`.
# This is the service-role key and bypasses RLS — treat it like a password.
SUPABASE_SECRET_KEY=your-service-role-key-here

# A DEDICATED Playwright user, not a real account. The suite creates and deletes
# items as this user, so never point it at an account holding real data.
# Provision one with the Supabase Admin API (email_confirm: true so no mail is
# needed), then mirror the same two values into GitHub Actions secrets.
TEST_USER_EMAIL=your-e2e-user@example.test
TEST_USER_PASSWORD=your-test-password-here

# NOTE: the API helpers authenticate to /api/agent/* with the test user's
# OpenClaw API key, fetched at runtime via GET /api/agent/apikey using the
# session cookies loginTestUser() injects. If the user has no key yet, the
# helper mints one via POST. No separate env var is required.
